+		def tracked_get_doc(doctype, name=None, *args, **kwargs):
+			if doctype == "Runner Pool" and kwargs.get("for_update"):
+				order.append("pool")
+			elif doctype == "Runner Lease" and kwargs.get("for_update"):
+				order.append("lease")
+			return original_get_doc(doctype, name, *args, **kwargs)
