new file mode 100644
index 0000000..550d62d
--- /dev/null
+++ b/central/runway.py
@@ -0,0 +1,297 @@
+"""Narrow regional cache authority. This credential is never a Central API key."""
+
+import secrets
+from hmac import compare_digest
+from ipaddress import IPv6Address
+from urllib.parse import urlsplit
+
+import frappe
+import requests
+
+from central.iam import user_has_operator_bypass
+from central.infrastructure.runway import iso_utc
+from central.integrations.object_storage import BucketInteractions
+from central.services.doctype.team_service.team_service import get_bucket_name
+
+METHODS = {"central.runway.cache_lease", "central.runway.cache_bucket"}
+CACHE_USER = "runway-cache@central.invalid"
+
+
+def mint_cache_configure_token(region_id: int) -> str:
+	"""Mint a short-lived credential that cannot authorize Cargo management."""
+	from central.sso import _mint_regional_token
+
+	return _mint_regional_token(region_id, f"runway-cache:{region_id}", "runway-cache-configure")
+
+
+def authenticate_cache():
+	header = frappe.get_request_header("Authorization", "")
+	# Normal Central API keys contain a colon and retain normal Frappe authentication.
+	if not header.startswith("token ") or ":" in header[6:]:
+		return
+	token = header[6:]
+	cmd = frappe.local.form_dict.get("cmd") or frappe.request.path.removeprefix("/api/method/")
+	if cmd not in METHODS or frappe.request.path != "/api/method/" + cmd or frappe.request.method != "GET":
+		raise frappe.AuthenticationError
+	matches = []
+	for name in frappe.get_all("Region", filters={"status": "Active"}, pluck="name"):
+		region = frappe.get_doc("Region", name)
+		credential = region.get_password("cache_service_credential", raise_exception=False)
+		if credential and compare_digest(token, credential):
+			matches.append(name)
+	if len(matches) != 1:
+		raise frappe.AuthenticationError
+	frappe.local.runway_cache_region = matches[0]
+	# A roleless system user satisfies Frappe's auth hook without operator authority.
+	arguments = frappe.local.form_dict
+	frappe.set_user(CACHE_USER)
+	frappe.local.form_dict = arguments
+
+
+def cache_region():
+	region = getattr(frappe.local, "runway_cache_region", None)
+	if not region or frappe.session.user != CACHE_USER:
+		raise frappe.AuthenticationError
+	return region
+
+
+def respond(body, status=200):
+	# Exact wire keys: no Frappe `message` envelope.
+	frappe.response.update(body)
+	frappe.response["http_status_code"] = status
+
+
+@frappe.whitelist(methods=["GET"])
+def cache_lease(address: str):
+	region = cache_region()
+	try:
+		mesh = IPv6Address(address)
+		if mesh.packed[:2] != b"\xfd\xaa":
+			return respond({"error": "not_found"}, 404)
+		address = str(mesh)
+	except ValueError:
+		return respond({"error": "not_found"}, 404)
+	matches = []
+	for row in frappe.get_all("Runner Lease", filters={"mesh_address": address}, fields=["name", "pool"]):
+		lease = frappe.get_doc("Runner Lease", row.name)
+		pool = frappe.get_doc("Runner Pool", row.pool)
+		if (
+			pool.region == region
+			and lease.vm_id
+			and lease.phase not in ("deleting", "deleted")
+			and lease.deadline
+			and frappe.utils.get_datetime(lease.deadline) > frappe.utils.now_datetime()
+		):
+			matches.append((lease, pool))
+	if len(matches) != 1:
+		return respond({"error": "ambiguous" if matches else "not_found"}, 409 if matches else 404)
+	lease, pool = matches[0]
+	job = None
+	if (
+		lease.job_id
+		or lease.started
+		or lease.workflow_run_id
+		or lease.job_display_name
+		or lease.job_workflow_ref
+		or lease.event_name
+	):
+		job = {
+			"job_id": lease.job_id or "",
+			"request_id": int(lease.request_id or 0),
+			"run_id": int(lease.workflow_run_id or 0),
+			"run_attempt": int(lease.run_attempt or 0),
+			"display_name": lease.job_display_name or "",
+			"workflow_ref": lease.job_workflow_ref or "",
+			"event_name": lease.event_name or "",
+			"started": bool(lease.started),
+			"ref": lease.get("ref") or "",
+			"sha": lease.get("sha") or "",
+			"verified": bool(lease.get("verified")),
+		}
+	respond(
+		{
+			"lease": lease.name,
+			"team": lease.team,
+			"tenant_id": int(frappe.db.get_value("Team", lease.team, "tenant_id")),
+			"region": region,
+			"repository": lease.repository
+			or pool.repository_url.removeprefix("https://github.com/").rstrip("/"),
+			"repository_id": int(lease.get("repository_id") or 0),
+			"default_branch": lease.get("default_branch") or "",
+			"vm_id": lease.vm_id,
+			"mesh_address": address,
+			"runner_id": int(lease.runner_id or 0),
+			"runner_name": lease.runner_name or "",
+			"job": job,
+			"deadline": iso_utc(lease.deadline),
+		}
+	)
+
+
+def bucket_filters(team, region):
+	return {
+		"team": team,
+		"region": region,
+		"add_on_service": "storage",
+		"runway_cache": 1,
+		"bucket_name": get_bucket_name(team, region, "runway-cache"),
+	}
+
+
+@frappe.whitelist(methods=["GET"])
+def cache_bucket(team: str | None = None, tenant_id: str | None = None):
+	region = cache_region()
+	# Managed cache-data knows the signed tenant, not Central's Team name.
+	if team is None and tenant_id is not None:
+		if not tenant_id.isdecimal() or not 0 < int(tenant_id) <= 4294967295:
+			return respond({"error": "not_found"}, 404)
+		teams = frappe.get_all("Team", filters={"tenant_id": int(tenant_id)}, pluck="name", limit=2)
+		if len(teams) != 1:
+			return respond({"error": "not_found"}, 404)
+		team = teams[0]
+	elif tenant_id is not None or team is None:
+		return respond({"error": "not_found"}, 404)
+	if not frappe.db.exists("Team", team):
+		return respond({"error": "not_found"}, 404)
+	name = frappe.db.exists("Team Service", {**bucket_filters(team, region), "status": "Active"})
+	if not name:
+		return respond({"error": "not_found"}, 404)
+	service = frappe.get_doc("Team Service", name)
+	respond(
+		{
+			"team": team,
+			"tenant_id": int(frappe.db.get_value("Team", team, "tenant_id")),
+			"bucket": service.bucket_name,
+			"endpoint": service.endpoint_url,
+			"region": service.region,
+			"access_key": service.access_key,
+			"secret_key": service.get_password("secret_access_key"),
+		}
+	)
+
+
+def reconcile_cache_buckets():
+	# Run outside document-save transactions. Frappe locks a pool before its hooks;
+	# reconciling there would invert the Team -> Pool order used by lease admission.
+	pairs = {(row.team, row.region) for row in frappe.get_all("Runner Pool", fields=["team", "region"])}
+	for row in frappe.get_all(
+		"Team Service",
+		filters={"add_on_service": "storage", "runway_cache": 1},
+		fields=["team", "region", "bucket_name"],
+	):
+		if row.region:
+			pairs.add((row.team, row.region))
+	for team, region in sorted(pairs):
+		# A new transaction also discards the enumeration's repeatable-read snapshot.
+		frappe.db.commit()
+		try:
+			reconcile_cache_bucket(team, region)
+			frappe.db.commit()
+		except Exception:
+			frappe.db.rollback()
+			# No credentials or upstream response bodies in logs.
+			frappe.logger().warning(
+				"Runway cache reconciliation failed for team %s region %s; retry pending", team, region
+			)
+
+
+def reconcile_cache_bucket(team, region):
+	# Team lock serializes reconciliations, including first create. Pool reads use
+	# current locking reads rather than an older repeatable-read snapshot.
+	frappe.db.get_value("Team", team, "name", for_update=True)
+	filters = bucket_filters(team, region)
+	name = frappe.db.get_value("Team Service", filters, "name", for_update=True)
+	enabled = frappe.db.get_value(
+		"Runner Pool",
+		{"team": team, "region": region, "status": "Active", "regional_cache": 1},
+		"name",
+		for_update=True,
+	)
+	if enabled and not name:
+		frappe.get_doc({"doctype": "Team Service", **filters}).insert(ignore_permissions=True)
+	elif name and not enabled:
+		service = frappe.get_doc("Team Service", name, for_update=True)
+		client = BucketInteractions(service).client
+		# Only this dedicated cache namespace is disposable. Failures retain the Team
+		# Service and its credentials, so a later reconciliation can finish draining.
+		for page in client.get_paginator("list_objects_v2").paginate(Bucket=service.bucket_name):
+			objects = [{"Key": obj["Key"]} for obj in page.get("Contents", [])]
+			if objects:
+				result = client.delete_objects(
+					Bucket=service.bucket_name, Delete={"Objects": objects, "Quiet": True}
+				)
+				if result.get("Errors"):
+					frappe.throw("Cache bucket cleanup failed; retry reconciliation.")
+		service.delete(ignore_permissions=True)
+
+
+class CacheConnectionMixin:
+	def validate_cache_connection(self):
+		self.cache_service_url = (self.cache_service_url or "").strip().rstrip("/")
+		if self.cache_service_url:
+			url = urlsplit(self.cache_service_url)
+			if (
+				url.scheme != "https"
+				or not url.hostname
+				or url.username
+				or url.password
+				or url.query
+				or url.fragment
+			):
+				frappe.throw("Cache service URL must be HTTPS without credentials, query or fragment.")
+
+	@frappe.whitelist(methods=["POST"])
+	def enroll_cache(self):
+		if not user_has_operator_bypass():
+			raise frappe.PermissionError
+		self.check_permission("write")
+		self.flags.for_update = True
+		self.reload()
+		self.validate_cache_connection()
+		if not self.cache_service_url:
+			frappe.throw("Set the cache service URL first.")
+		if not frappe.db.exists("User", CACHE_USER):
+			frappe.get_doc(
+				{
+					"doctype": "User",
+					"email": CACHE_USER,
+					"first_name": "Runway Cache",
+					"user_type": "System User",
+					"enabled": 0,
+					"send_welcome_email": 0,
+				}
+			).insert(ignore_permissions=True, ignore_if_duplicate=True)
+		credential = secrets.token_urlsafe(32)
+		from central.sso import central_url
+
+		# Configure has its own audience and scope; never expose a Cargo credential.
+		response = requests.post(
+			self.cache_service_url + "/configure",
+			headers={"Authorization": "Bearer " + mint_cache_configure_token(self.get_atlas_region_id())},
+			json={"central_url": central_url(), "region": self.name, "credential": credential},
+			timeout=(5, 20),
+			allow_redirects=False,
+		)
+		from cryptography import x509
+		import re
+
+		result = response.json()
+		if response.status_code != 200 or not isinstance(result, dict) or set(result) != {"configured", "ca"} or result["configured"] is not True:
+			frappe.throw("Cache service rejected configuration.")
+		try:
+			name, port = self.cache_service_name.rsplit(":", 1)
+			if not re.fullmatch(r"internal-[a-z0-9][a-z0-9.-]*", name) or not 1 <= int(port) <= 65535:
+				raise ValueError("Invalid cache service name")
+			pem = result["ca"]
+			if not isinstance(pem, str) or not re.fullmatch(r"\s*-----BEGIN CERTIFICATE-----[A-Za-z0-9+/=\s]+-----END CERTIFICATE-----\s*", pem):
+				raise ValueError("Expected one public certificate")
+			certificate = x509.load_pem_x509_certificate(pem.encode())
+			if not certificate.extensions.get_extension_for_class(x509.BasicConstraints).value.ca:
+				raise ValueError("Expected CA certificate")
+			if name not in certificate.extensions.get_extension_for_class(x509.SubjectAlternativeName).value.get_values_for_type(x509.DNSName):
+				raise ValueError("Missing service SAN")
+		except (ValueError, TypeError, AttributeError, x509.ExtensionNotFound):
+			frappe.throw("Cache service returned an invalid CA or service name.")
+		self.cache_service_ca = pem
+		self.cache_service_credential = credential
+		self.save()
