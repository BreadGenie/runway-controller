diff --git a/central/infrastructure/doctype/runner_lease/runner_lease.py b/central/infrastructure/doctype/runner_lease/runner_lease.py
new file mode 100644
index 0000000..1777f64
--- /dev/null
+++ b/central/infrastructure/doctype/runner_lease/runner_lease.py
@@ -0,0 +1,37 @@
+import frappe
+from frappe import _
+from frappe.model.document import Document
+
+
+class RunnerLease(Document):
+	def validate(self) -> None:
+		if frappe.db.get_value("Runner Pool", self.pool, "team") != self.team:
+			frappe.throw(_("Runner lease and pool must belong to the same Team."))
+		if not self.is_new() and any(
+			self.has_value_changed(field) for field in ("team", "pool", "attempt_id", "runner_name")
+		):
+			frappe.throw(_("Runner lease identity is immutable."))
+
+	@frappe.whitelist(methods=["POST"])
+	def reconcile(self, cleanup: bool = False) -> None:
+		from central.iam import user_has_operator_bypass
+		from central.integrations.runway import reconcile_lease
+
+		if not user_has_operator_bypass():
+			frappe.throw(_("Only an operator can reconcile a runner from Desk."), frappe.PermissionError)
+		self.reload()
+		if cleanup and self.phase != "deleted":
+			self.phase = "deleting"
+			self.save()
+		frappe.db.commit()
+		reconcile_lease(frappe.get_doc("Runner Pool", self.pool), self.name)
+
+	def on_trash(self) -> None:
+		frappe.throw(_("Runner leases are durable audit records and cannot be deleted."))
+
+
+def on_doctype_update() -> None:
+	frappe.db.add_index("Runner Lease", ["team", "phase"])
+	frappe.db.add_index("Runner Lease", ["pool", "phase"])
+	frappe.db.add_unique("Runner Lease", ["attempt_id"])
+	frappe.db.add_unique("Runner Lease", ["runner_name"])
