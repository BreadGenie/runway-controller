new file mode 100644
index 0000000..3327522
--- /dev/null
+++ b/central/infrastructure/runway.py
@@ -0,0 +1,283 @@
+from datetime import UTC
+from uuid import UUID
+from zoneinfo import ZoneInfo
+
+import frappe
+from frappe import _
+from frappe.utils import add_to_date, get_datetime, get_system_timezone, now_datetime
+
+from central.iam import can, user_has_operator_bypass
+
+OWNER_TTL_SECONDS = 60
+TEAM_CONCURRENCY_LIMIT = 4
+
+
+def authorize(pool) -> None:
+	if user_has_operator_bypass():
+		return
+	if frappe.session.user != pool.controller_user or not all(
+		can(frappe.session.user, pool.team, capability)
+		for capability in ("server:view", "server:create", "server:terminate")
+	):
+		frappe.throw(_("This user cannot control the runner pool."), frappe.PermissionError)
+
+
+def locked_pool(name: str):
+	pool = frappe.get_doc("Runner Pool", name, for_update=True)
+	authorize(pool)
+	return pool
+
+
+def check_fence(pool, owner_id: str, fence: int) -> None:
+	if (
+		pool.controller_owner != owner_id
+		or int(pool.fence or 0) != int(fence)
+		or not pool.owner_expires_at
+		or get_datetime(pool.owner_expires_at) <= now_datetime()
+	):
+		frappe.throw(_("Runner controller ownership expired or changed."), frappe.PermissionError)
+
+
+def save_internal(document) -> None:
+	# Controller routes authorize the pool; service users cannot write lifecycle fields through Desk or REST.
+	document.save(ignore_permissions=True)
+
+
+def active_leases(pool: str | None = None, team: str | None = None, lock: bool = False) -> list:
+	lease = frappe.qb.DocType("Runner Lease")
+	query = (
+		frappe.qb.from_(lease)
+		.select(lease.name)
+		.where((lease.phase != "deleted") | (lease.jit_state != "removed"))
+		.orderby(lease.creation)
+	)
+	if pool:
+		query = query.where(lease.pool == pool)
+	if team:
+		query = query.where(lease.team == team)
+	if lock:
+		query = query.for_update()
+	return query.run(as_dict=True)
+
+
+def iso_utc(value) -> str | None:
+	if not value:
+		return None
+	return get_datetime(value).replace(tzinfo=ZoneInfo(get_system_timezone())).astimezone(UTC).isoformat()
+
+
+def lease_snapshot(lease) -> dict:
+	fields = (
+		"pool",
+		"team",
+		"phase",
+		"runner_name",
+		"runner_id",
+		"job_id",
+		"workflow_run_id",
+		"vm_id",
+		"vm_state",
+		"mesh_address",
+		"last_error",
+		"jit_state",
+		"attempt_id",
+		"acquire_state",
+		"repository",
+		"request_labels",
+	)
+	result = {field: lease.get(field) or (0 if field == "runner_id" else "") for field in fields}
+	return {
+		"id": lease.name,
+		**result,
+		"request_id": int(lease.request_id or 0),
+		"deadline": iso_utc(lease.deadline),
+	}
+
+
+def pool_snapshot(pool) -> dict:
+	fields = ("team", "region", "repository_url", "scale_set_id", "max_concurrency", "max_job_seconds")
+	return {
+		"fence": int(pool.fence),
+		"pool": {
+			"id": pool.name,
+			**{field: pool.get(field) for field in fields},
+			"enabled": pool.status == "Active",
+			"owner_expires_at": iso_utc(pool.owner_expires_at),
+		},
+		"leases": [
+			lease_snapshot(frappe.get_doc("Runner Lease", row.name))
+			for row in active_leases(pool=pool.name, team=pool.team)
+		],
+	}
+
+
+def claim_pool(pool: str, owner_id: str) -> dict:
+	if not owner_id or len(owner_id) > 128:
+		frappe.throw(_("Supply a controller instance identity."))
+	document = locked_pool(pool)
+	if (
+		document.controller_owner
+		and document.controller_owner != owner_id
+		and document.owner_expires_at
+		and get_datetime(document.owner_expires_at) > now_datetime()
+	):
+		frappe.throw(_("Another runner controller owns this pool."))
+	document.controller_owner = owner_id
+	document.fence = int(document.fence or 0) + 1
+	document.owner_expires_at = add_to_date(now_datetime(), seconds=OWNER_TTL_SECONDS)
+	save_internal(document)
+	return pool_snapshot(document)
+
+
+def renew_pool(pool: str, owner_id: str, fence: int, last_error: str = "") -> dict:
+	document = locked_pool(pool)
+	check_fence(document, owner_id, fence)
+	document.owner_expires_at = add_to_date(now_datetime(), seconds=OWNER_TTL_SECONDS)
+	document.last_error = str(last_error)[:1000]
+	save_internal(document)
+	return pool_snapshot(document)
+
+
+def reserve_lease(pool: str, owner_id: str, fence: int, lease_id: str) -> dict:
+	# Admission is database-only and keyed by the caller's UUID. Retrying a rolled-back
+	# snapshot conflict cannot repeat an Atlas or GitHub mutation.
+	for attempt in range(3):
+		try:
+			return _reserve_lease(pool, owner_id, fence, lease_id)
+		except frappe.QueryDeadlockError:
+			frappe.db.rollback()
+			if attempt == 2:
+				raise
+
+
+def _reserve_lease(pool: str, owner_id: str, fence: int, lease_id: str) -> dict:
+	try:
+		identity = str(UUID(lease_id))
+	except ValueError, TypeError, AttributeError:
+		frappe.throw(_("Runner lease identity must be a UUID."))
+	team = frappe.db.get_value("Runner Pool", pool, "team")
+	# Serialize aggregate team admission before pool admission, in one lock order.
+	frappe.get_doc("Team", team, for_update=True)
+	document = locked_pool(pool)
+	check_fence(document, owner_id, fence)
+	if frappe.db.exists("Runner Lease", identity):
+		lease = scoped_lease(document, identity)
+		return lease_snapshot(lease)
+	if document.status != "Active":
+		frappe.throw(_("The runner pool is paused."))
+	if (
+		len(active_leases(pool=pool, team=team, lock=True)) >= int(document.max_concurrency)
+		or len(active_leases(team=team, lock=True)) >= TEAM_CONCURRENCY_LIMIT
+	):
+		frappe.throw(_("Runner capacity is exhausted."))
+	lease = frappe.get_doc(
+		{
+			"doctype": "Runner Lease",
+			"name": identity,
+			"pool": pool,
+			"team": team,
+			"phase": "reserved",
+			"attempt_id": identity,
+			"fence": int(fence),
+			"runner_name": f"runway-{UUID(identity).hex}",
+			"jit_state": "none",
+			"acquire_state": "none",
+			"deadline": add_to_date(now_datetime(), seconds=int(document.max_job_seconds)),
+		}
+	)
+	# The authenticated pool controller owns the reserved identity and capacity.
+	lease.insert(ignore_permissions=True, set_name=identity)
+	return lease_snapshot(lease)
+
+
+def scoped_lease(pool, lease_id: str):
+	lease = frappe.get_doc("Runner Lease", lease_id, for_update=True)
+	if lease.pool != pool.name or lease.team != pool.team:
+		frappe.throw(_("Runner lease belongs to another pool."), frappe.PermissionError)
+	return lease
+
+
+def fenced_lease(pool: str, owner_id: str, fence: int, lease_id: str):
+	document = locked_pool(pool)
+	check_fence(document, owner_id, fence)
+	return document, scoped_lease(document, lease_id)
+
+
+def update_lease(
+	pool: str,
+	owner_id: str,
+	fence: int,
+	lease_id: str,
+	event: str,
+	runner_id: int = 0,
+	job_id: str = "",
+	workflow_run_id: str = "",
+	result: str = "",
+	error: str = "",
+	request_id: int = 0,
+	repository: str = "",
+	request_labels: str = "",
+) -> dict:
+	_pool, lease = fenced_lease(pool, owner_id, fence, lease_id)
+	# Missing evidence leaves earlier observations intact, including direct dispatch
+	# with request ID zero. A replay may add identity, but cannot replace it.
+	if not 0 <= int(request_id) < 2**63 or (
+		request_id and lease.request_id and int(lease.request_id) != int(request_id)
+	):
+		frappe.throw(_("Job request identity changed within a lease."))
+	identities = (
+		("runner_id", runner_id),
+		("job_id", job_id),
+		("workflow_run_id", workflow_run_id),
+		("repository", repository),
+		("request_labels", request_labels),
+	)
+	for field, value in identities:
+		if value and lease.get(field) and str(lease.get(field)) != str(value):
+			frappe.throw(_("Runner job identity changed within a lease."))
+	if event == "acquire_requested":
+		if not request_id:
+			frappe.throw(_("Job acquisition identity must remain a positive request ID."))
+		if lease.phase in ("deleting", "deleted"):
+			frappe.throw(_("A retiring runner cannot acquire work."))
+		lease.request_id = str(request_id)
+		lease.acquire_state = "pending" if lease.acquire_state != "acquired" else "acquired"
+	elif event == "acquired":
+		if not lease.request_id or lease.acquire_state not in ("pending", "acquired"):
+			frappe.throw(_("Persist job acquisition intent first."))
+		lease.acquire_state = "acquired"
+	elif event == "runner_removed":
+		lease.jit_state = "removed"
+	elif event in ("completed", "failed"):
+		if lease.phase != "deleted":
+			lease.phase = "deleting"
+		lease.result = str(result)[:140]
+		lease.completed_at = now_datetime()
+	else:
+		transitions = {
+			"jit_requested": ("vm_ready", "jit_pending"),
+			"jit_ready": ("jit_pending", "jit_ready"),
+			"bootstrapped": ("jit_ready", "running"),
+			"started": ("running", "running"),
+		}
+		if event not in transitions:
+			frappe.throw(_("Unknown runner lease event."))
+		before, after = transitions[event]
+		if lease.phase not in (before, after):
+			frappe.throw(_("Runner lease event is invalid for its phase."))
+		lease.phase = after
+		if event in ("jit_requested", "jit_ready"):
+			lease.jit_state = "pending" if event == "jit_requested" else "ready"
+		if event in ("started", "bootstrapped"):
+			lease.started_at = lease.started_at or now_datetime()
+	for field, value in identities:
+		if value:
+			lease.set(field, value)
+	if request_id:
+		lease.request_id = str(request_id)
+	# The lease is a durable audit record. An event that carries no new error must keep the
+	# recorded retirement reason or the failure to collect job diagnostics.
+	if error:
+		lease.last_error = str(error)[:1000]
+	save_internal(lease)
+	return lease_snapshot(lease)
diff --git a/central/integrations/runway.py b/central/integrations/runway.py
new file mode 100644
index 0000000..b65506a
--- /dev/null
+++ b/central/integrations/runway.py
@@ -0,0 +1,192 @@
+import frappe
+from frappe.utils import get_datetime, now_datetime
+
+from central.errors import AtlasConnectionError, AtlasRejected, AtlasRequestUncertain, AtlasResourceGone
+from central.infrastructure.runway import active_leases, fenced_lease, lease_snapshot, save_internal
+from central.integrations.atlas import AtlasClient
+
+
+def client_for_pool(pool) -> AtlasClient:
+	return AtlasClient.for_team(frappe.get_doc("Region", pool.region), pool.team, capability="server:create")
+
+
+def ensure_vm(pool: str, owner_id: str, fence: int, lease_id: str) -> dict:
+	document, lease = fenced_lease(pool, owner_id, fence, lease_id)
+	if (
+		lease.phase == "reserved"
+		and get_datetime(lease.deadline) > now_datetime()
+		and document.status == "Active"
+	):
+		lease.phase = "provisioning"
+		lease.create_dispatched_at = now_datetime()
+		save_internal(lease)
+		# Persist one dispatch intent before sending. An interrupted dispatch is never sent again.
+		frappe.db.commit()
+		create_vm(document, lease)
+	else:
+		frappe.db.commit()
+	reconcile_lease(document, lease.name)
+	return lease_snapshot(frappe.get_doc("Runner Lease", lease.name))
+
+
+def create_vm(pool, lease) -> None:
+	payload = {
+		"image_id": pool.image_id,
+		"cpu_millicores": pool.cpu_millicores,
+		"memory_mib": pool.memory_mib,
+		"disk_mib": pool.disk_mib,
+		"hostname": lease.runner_name,
+		"ssh_keys": [pool.ssh_public_key],
+		"sleep_after_idle_seconds": 0,
+		"tags": {"runway_pool": pool.name, "runway_lease": lease.name, "role": "ci", "team": pool.team},
+	}
+	try:
+		response = client_for_pool(pool).create_vm(payload)
+	except AtlasRejected:
+		lease.reload()
+		lease.phase = "deleting"
+		lease.create_dispatched_at = None
+		lease.last_error = "Atlas rejected VM creation."
+	except AtlasRequestUncertain, AtlasConnectionError:
+		lease.reload()
+		lease.phase = "uncertain" if lease.phase not in ("deleting", "deleted") else lease.phase
+		lease.last_error = "VM creation outcome is uncertain; reconciling tags without another create."
+	else:
+		lease.reload()
+		if not response.get("id"):
+			lease.phase = "uncertain" if lease.phase not in ("deleting", "deleted") else lease.phase
+			lease.last_error = "Atlas create response did not identify a VM."
+		else:
+			lease.vm_id = response["id"]
+	save_internal(lease)
+	frappe.db.commit()
+
+
+def pool_vms(pool) -> list[dict]:
+	client = client_for_pool(pool)
+	rows = []
+	offset = 0
+	while True:
+		page = client.list_vms(limit=100, offset=offset)
+		rows.extend(vm for vm in page if vm.get("tags", {}).get("runway_pool") == pool.name)
+		if len(page) < 100:
+			return rows
+		offset += 100
+
+
+def find_vm(pool, lease) -> str | None:
+	matches = [vm for vm in pool_vms(pool) if vm.get("tags", {}).get("runway_lease") == lease.name]
+	if len(matches) == 1:
+		return matches[0]["id"]
+	if len(matches) > 1:
+		lease.last_error = "Multiple VMs match the lease; operator review is required."
+	return None
+
+
+def mark_deleted(lease) -> None:
+	lease.phase = "deleted"
+	lease.deleted_at = now_datetime()
+	lease.vm_state = "absent"
+	if lease.jit_state == "none":
+		lease.jit_state = "removed"
+
+
+def reconcile_lease(pool, name: str) -> None:
+	# Take the pool row lock before the lease row lock, matching fenced_lease.
+	# A reaper that locked the lease first would hold it across Atlas calls and
+	# deadlock every controller RPC that already owns the pool lock.
+	pool = frappe.get_doc("Runner Pool", pool.name, for_update=True)
+	lease = frappe.get_doc("Runner Lease", name, for_update=True)
+	if lease.phase == "deleted":
+		frappe.db.commit()
+		return
+	if get_datetime(lease.deadline) <= now_datetime():
+		lease.phase = "deleting"
+	if not lease.vm_id and lease.create_dispatched_at:
+		lease.vm_id = find_vm(pool, lease)
+	if not lease.vm_id:
+		if lease.phase == "deleting" and not lease.create_dispatched_at:
+			mark_deleted(lease)
+		save_internal(lease)
+		frappe.db.commit()
+		return
+	client = client_for_pool(pool)
+	try:
+		state = client.get_vm(lease.vm_id)
+	except AtlasResourceGone:
+		mark_deleted(lease)
+	else:
+		lease.vm_state = state.get("current_state") or "unknown"
+		lease.mesh_address = (state.get("network") or {}).get("mesh_ipv6") or ""
+		if lease.phase == "deleting":
+			lease.delete_requested_at = lease.delete_requested_at or now_datetime()
+			save_internal(lease)
+			frappe.db.commit()
+			try:
+				client.vm_action(lease.vm_id, "terminate")
+			except AtlasResourceGone:
+				# Confirm through GET on the next pass, rather than infer completion from DELETE.
+				pass
+			except AtlasRequestUncertain:
+				lease.reload()
+				lease.last_error = "VM deletion outcome is uncertain; waiting for scoped absence."
+				save_internal(lease)
+				frappe.db.commit()
+			return
+		elif lease.phase in ("provisioning", "uncertain") and lease.vm_state == "running":
+			lease.phase = "vm_ready"
+	save_internal(lease)
+	frappe.db.commit()
+
+
+def request_delete(pool: str, owner_id: str, fence: int, lease_id: str) -> dict:
+	document, lease = fenced_lease(pool, owner_id, fence, lease_id)
+	if lease.phase != "deleted":
+		lease.phase = "deleting"
+		save_internal(lease)
+	frappe.db.commit()
+	reconcile_lease(document, lease.name)
+	return lease_snapshot(frappe.get_doc("Runner Lease", lease.name))
+
+
+def sweep() -> None:
+	# A system task repairs only VMs bearing an existing pool and lease identity.
+	for row in frappe.get_all("Runner Pool", fields=["name", "team"]):
+		pool = frappe.get_doc("Runner Pool", row.name)
+		for lease in active_leases(pool=pool.name, team=pool.team):
+			# End the read view opened by the enumeration above. reconcile_lease
+			# locks the pool row, and a controller renewal that commits in between
+			# would fail this transaction with "record has changed since last read".
+			frappe.db.commit()
+			try:
+				reconcile_lease(pool, lease.name)
+			except AtlasConnectionError:
+				frappe.db.rollback()
+				frappe.db.set_value(
+					"Runner Lease",
+					lease.name,
+					"last_error",
+					"Regional reconciliation failed; cleanup remains pending.",
+				)
+				frappe.db.commit()
+		try:
+			remove_orphans(pool)
+		except AtlasConnectionError:
+			frappe.db.rollback()
+			frappe.db.set_value("Runner Pool", pool.name, "last_error", "Regional orphan scan failed.")
+			frappe.db.commit()
+
+
+def remove_orphans(pool) -> None:
+	client = client_for_pool(pool)
+	for vm in pool_vms(pool):
+		tags = vm.get("tags") or {}
+		identity = tags.get("runway_lease")
+		if not identity or tags.get("team") != pool.team or tags.get("role") != "ci":
+			continue
+		if frappe.db.exists("Runner Lease", {"name": identity, "pool": pool.name, "team": pool.team}):
+			continue
+		try:
+			client.vm_action(vm["id"], "terminate")
+		except AtlasResourceGone, AtlasRequestUncertain:
+			pass
