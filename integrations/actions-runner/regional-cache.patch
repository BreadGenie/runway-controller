diff --git a/src/Runner.Worker/RegionalCacheSetup.cs b/src/Runner.Worker/RegionalCacheSetup.cs
new file mode 100644
index 0000000..ccf2f11
--- /dev/null
+++ b/src/Runner.Worker/RegionalCacheSetup.cs
@@ -0,0 +1,163 @@
+using System;
+using System.Collections.Generic;
+using System.ComponentModel;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+using GitHub.DistributedTask.Pipelines;
+using GitHub.DistributedTask.Pipelines.ContextData;
+using GitHub.Runner.Common;
+
+namespace GitHub.Runner.Worker
+{
+    // No credentials or workflow variables cross this boundary.
+    public sealed class RegionalCacheSnapshot
+    {
+        internal Guid JobId { get; }
+        internal long RequestId { get; }
+        internal string Request { get; }
+        internal string Nonce { get; }
+        private RegionalCacheSnapshot(Guid jobId, long requestId, string nonce, string request)
+        { JobId = jobId; RequestId = requestId; Nonce = nonce; Request = request; }
+
+        internal static RegionalCacheSnapshot Capture(AgentJobRequestMessage message)
+        {
+            var context = new Dictionary<string, string>();
+            DictionaryContextData github = null;
+            if (message.ContextData != null && message.ContextData.TryGetValue("github", out var value))
+                github = value as DictionaryContextData;
+            foreach (var field in new[] { "repository", "repository_id", "run_id", "run_attempt", "ref", "ref_type", "sha", "event_name", "base_ref", "head_ref" })
+            {
+                string scalar = null;
+                if (github != null && github.TryGetValue(field, out var data))
+                {
+                    if (data is StringContextData text) scalar = text.Value;
+                    else if (data is NumberContextData number && double.IsFinite(number.Value)) scalar = number.Value.ToString("R", CultureInfo.InvariantCulture);
+                }
+                context[field] = scalar != null && scalar.Length <= 2048 ? scalar : null;
+            }
+            var nonce = Guid.NewGuid().ToString("D");
+            return new RegionalCacheSnapshot(message.JobId, message.RequestId, nonce,
+                JsonSerializer.Serialize(new { version = 1, job_id = message.JobId.ToString("D"), request_id = message.RequestId, nonce, context }));
+        }
+    }
+
+    internal sealed class RegionalCacheRoute
+    {
+        internal const string ApprovedRoute = "http://127.0.0.1:18080/";
+        internal static readonly RegionalCacheRoute Disabled = new RegionalCacheRoute(false);
+        internal static readonly RegionalCacheRoute Enabled = new RegionalCacheRoute(true);
+        private readonly bool _enabled;
+        private RegionalCacheRoute(bool enabled) { _enabled = enabled; }
+
+        internal void Apply(ActionStepDefinitionReference action, string resolvedName, string resolvedSha, IDictionary<string, string> environment)
+        {
+            // Compatibility follows the authenticated download, never the workflow ref or environment.
+            if (!_enabled || !(action is RepositoryPathReference repo) || repo.RepositoryType != "GitHub" || repo.Name != resolvedName) return;
+            bool compatible = (repo.Name == "actions/cache" && resolvedSha == "0057852bfaa89a56745cba8c7296529d2fc39830"
+                    && (string.IsNullOrEmpty(repo.Path) || repo.Path == "restore" || repo.Path == "save"))
+                || (repo.Name == "actions/setup-node" && resolvedSha == "249970729cb0ef3589644e2896645e5dc5ba9c38" && string.IsNullOrEmpty(repo.Path));
+            if (!compatible) return;
+            environment["ACTIONS_CACHE_URL"] = ApprovedRoute;
+            environment.Remove("ACTIONS_CACHE_SERVICE_V2");
+        }
+    }
+
+    [ServiceLocator(Default = typeof(RegionalCacheSetup))]
+    public interface IRegionalCacheSetup : IRunnerService
+    {
+        Task SetupAsync(RegionalCacheSnapshot snapshot, GlobalContext global, CancellationToken cancellationToken);
+    }
+
+    public sealed class RegionalCacheSetup : RunnerService, IRegionalCacheSetup
+    {
+        public async Task SetupAsync(RegionalCacheSnapshot snapshot, GlobalContext global, CancellationToken cancellationToken)
+        {
+            // Use only the pre-gate serialized snapshot; never re-read message/expression/env state.
+            var route = await SelectAsync(snapshot, "/opt/runway/bin/cache-setup", "/opt/runway", TimeSpan.FromSeconds(5), cancellationToken);
+            global.SetRegionalCacheRoute(route);
+        }
+
+        internal static async Task<RegionalCacheRoute> SelectAsync(RegionalCacheSnapshot snapshot, string helper, string directory, TimeSpan timeout, CancellationToken cancellationToken)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            if (snapshot.JobId == Guid.Empty || snapshot.RequestId < 0) return RegionalCacheRoute.Disabled;
+            using var deadline = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            deadline.CancelAfter(timeout);
+            var start = new ProcessStartInfo("/usr/bin/python3") {
+                WorkingDirectory = directory, UseShellExecute = false, RedirectStandardInput = true,
+                RedirectStandardOutput = true, RedirectStandardError = true, CreateNoWindow = true
+            };
+            start.ArgumentList.Add("-I");
+            start.ArgumentList.Add(helper);
+            start.Environment.Clear();
+            using var process = new Process { StartInfo = start };
+            bool started = false;
+            try
+            {
+                if (System.Text.Encoding.UTF8.GetByteCount(snapshot.Request) > 32768) return RegionalCacheRoute.Disabled;
+                started = process.Start();
+                if (!started) return RegionalCacheRoute.Disabled;
+                var output = ReadAsync(process.StandardOutput.BaseStream, deadline);
+                var errors = ReadAsync(process.StandardError.BaseStream, deadline);
+                var input = WriteAsync(process, snapshot.Request, deadline.Token);
+                await Task.WhenAll(input, output, errors, process.WaitForExitAsync(deadline.Token));
+                deadline.Token.ThrowIfCancellationRequested();
+                return process.ExitCode == 0 && IsEnabled(await output, snapshot) ? RegionalCacheRoute.Enabled : RegionalCacheRoute.Disabled;
+            }
+            catch (Exception ex) when (ex is IOException || ex is Win32Exception || ex is InvalidOperationException || ex is OperationCanceledException)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                return RegionalCacheRoute.Disabled;
+            }
+            finally
+            {
+                deadline.Cancel();
+                try { if (started && !process.HasExited) process.Kill(entireProcessTree: true); }
+                catch (InvalidOperationException) { }
+                catch (Win32Exception) { }
+            }
+        }
+
+        private static async Task WriteAsync(Process process, string request, CancellationToken token)
+        {
+            await process.StandardInput.WriteAsync(request.AsMemory(), token);
+            process.StandardInput.Close();
+        }
+        private static async Task<byte[]> ReadAsync(Stream stream, CancellationTokenSource deadline)
+        {
+            var bytes = new byte[4097];
+            int length = 0;
+            while (length < bytes.Length)
+            {
+                int read = await stream.ReadAsync(bytes.AsMemory(length), deadline.Token);
+                if (read == 0) return bytes.Take(length).ToArray();
+                length += read;
+            }
+            deadline.Cancel();
+            throw new InvalidOperationException("Cache setup output limit exceeded.");
+        }
+        private static bool IsEnabled(byte[] bytes, RegionalCacheSnapshot snapshot)
+        {
+            try
+            {
+                using var doc = JsonDocument.Parse(bytes, new JsonDocumentOptions { MaxDepth = 2 });
+                var root = doc.RootElement;
+                var names = new[] { "version", "job_id", "request_id", "nonce", "outcome", "route" };
+                if (root.ValueKind != JsonValueKind.Object || root.EnumerateObject().Count() != names.Length
+                    || !root.EnumerateObject().Select(p => p.Name).OrderBy(n => n).SequenceEqual(names.OrderBy(n => n))) return false;
+                return root.GetProperty("version").GetInt32() == 1
+                    && root.GetProperty("job_id").GetString() == snapshot.JobId.ToString("D")
+                    && root.GetProperty("request_id").GetInt64() == snapshot.RequestId
+                    && root.GetProperty("nonce").GetString() == snapshot.Nonce
+                    && root.GetProperty("outcome").GetString() == "enabled"
+                    && root.GetProperty("route").GetString() == RegionalCacheRoute.ApprovedRoute;
+            }
+            catch (Exception ex) when (ex is JsonException || ex is InvalidOperationException || ex is KeyNotFoundException || ex is FormatException) { return false; }
+        }
+    }
+}
