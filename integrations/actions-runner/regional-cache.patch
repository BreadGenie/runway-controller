+namespace GitHub.Runner.Common.Tests.Worker
+{
+    public sealed partial class ActionManagerL0
+    {
+        private const string CacheSha = "0057852bfaa89a56745cba8c7296529d2fc39830";
+        private const string NodeSha = "249970729cb0ef3589644e2896645e5dc5ba9c38";
+
+        public static IEnumerable<object[]> RegionalCacheResolutionCases()
+        {
+            foreach (bool batch in new[] { false, true })
+            foreach (int cached in new[] { 0, 1, 2 })
+            foreach (bool composite in new[] { false, true })
+            {
+                yield return new object[] { batch, cached, composite, "actions/cache", "v4", "actions/cache", CacheSha, "", true };
+                yield return new object[] { batch, cached, composite, "actions/cache", "v4", "actions/cache", CacheSha, "restore", true };
+                yield return new object[] { batch, cached, composite, "actions/cache", "v4", "actions/cache", CacheSha, "save", true };
+                yield return new object[] { batch, cached, composite, "actions/setup-node", "v6", "actions/setup-node", NodeSha, "", true };
+                yield return new object[] { batch, cached, composite, "actions/setup-node", "v6", "actions/setup-node", CacheSha, "", false };
+                yield return new object[] { batch, cached, composite, "actions/cache", "v4", "actions/cache", NodeSha, "", false };
+                yield return new object[] { batch, cached, composite, "other/cache", "v4", "other/cache", CacheSha, "", false };
+                yield return new object[] { batch, cached, composite, "actions/cache", "v4", "other/cache", CacheSha, "", false };
+                yield return new object[] { batch, cached, composite, "actions/cache", "v4", "actions/cache", CacheSha, "unsupported", false };
+                yield return new object[] { batch, cached, composite, "actions/setup-node", "v6", "actions/setup-node", NodeSha, "restore", false };
+                // A workflow SHA alone grants no compatibility without matching resolved metadata.
+                yield return new object[] { batch, cached, composite, "actions/cache", CacheSha, "actions/cache", NodeSha, "", false };
+                // No tag allowlist: any ref resolving to the tested bytes is compatible.
+                yield return new object[] { batch, cached, composite, "actions/cache", "custom-ref", "actions/cache", CacheSha, "", true };
+            }
+        }
+
+        [Theory]
+        [MemberData(nameof(RegionalCacheResolutionCases))]
+        [Trait("Category", "Worker")]
+        public async Task RegionalCacheResolutionUsesDownloadedIdentity(bool batch, int cached, bool composite,
+            string name, string reference, string resolvedName, string sha, string path, bool regional)
+        {
+            string priorCache = Environment.GetEnvironmentVariable(Constants.Variables.Agent.ActionArchiveCacheDirectory);
+            string priorSymlink = Environment.GetEnvironmentVariable(Constants.Variables.Agent.SymlinkCachedActions);
+            try
+            {
+                Setup();
+                _ec.Object.Global.Variables.Set(Constants.Runner.Features.BatchActionResolution, batch.ToString());
+                _ec.Object.Global.SetRegionalCacheRoute(RegionalCacheRoute.Enabled);
+                _configurationStore.Object.GetSettings().IsHostedServer = true;
+                Environment.SetEnvironmentVariable(Constants.Variables.Agent.SymlinkCachedActions, cached == 2 ? "true" : "false");
+                var target = new Pipelines.RepositoryPathReference { RepositoryType = "GitHub", Name = name, Ref = reference, Path = path };
+                var targetStep = new Pipelines.ActionStep { Id = Guid.NewGuid(), Reference = target };
+                var infos = new List<ActionDownloadInfo>();
+                _jobServer.Setup(x => x.ResolveActionDownloadInfoAsync(It.IsAny<Guid>(), It.IsAny<string>(), It.IsAny<Guid>(), It.IsAny<Guid>(), It.IsAny<ActionReferenceList>(), It.IsAny<CancellationToken>()))
+                    .Returns((Guid scope, string hub, Guid plan, Guid job, ActionReferenceList list, CancellationToken token) =>
+                    {
+                        var result = new ActionDownloadInfoCollection { Actions = new Dictionary<string, ActionDownloadInfo>() };
+                        foreach (var action in list.Actions)
+                        {
+                            bool wrapper = action.NameWithOwner == "test/wrapper";
+                            var info = new ActionDownloadInfo {
+                                NameWithOwner = action.NameWithOwner, Ref = action.Ref,
+                                ResolvedNameWithOwner = wrapper ? "test/wrapper" : resolvedName,
+                                ResolvedSha = wrapper ? "wrapper-sha" : sha,
+                                TarballUrl = $"https://api.github.com/repos/{action.NameWithOwner}/tarball/{action.Ref}",
+                                ZipballUrl = $"https://api.github.com/repos/{action.NameWithOwner}/zipball/{action.Ref}"
+                            };
+                            infos.Add(info);
+                            result.Actions[$"{action.NameWithOwner}@{action.Ref}"] = info;
+                        }
+                        return Task.FromResult(result);
+                    });
+                string archive = CreateRegionalCacheArchive("name: node\nruns:\n  using: node20\n  main: task.js\n");
+                string wrapperArchive = CreateRegionalCacheArchive($"name: wrapper\nruns:\n  using: composite\n  steps:\n    - uses: {name}{(string.IsNullOrEmpty(path) ? "" : "/" + path)}@{reference}\n    - uses: {name}{(string.IsNullOrEmpty(path) ? "" : "/" + path)}@{reference}\n");
+                string cacheDirectory = Path.Combine(_workFolder, "archive-cache");
+                Directory.CreateDirectory(cacheDirectory);
+                Environment.SetEnvironmentVariable(Constants.Variables.Agent.ActionArchiveCacheDirectory, cached != 0 ? cacheDirectory : null);
+                if (cached != 0)
+                {
+                    string repoCache = Path.Combine(cacheDirectory, resolvedName.Replace('/', '_'));
+                    Directory.CreateDirectory(repoCache);
+#if OS_WINDOWS
+                    if (cached == 1) File.Copy(archive, Path.Combine(repoCache, sha + ".zip"));
+#else
+                    if (cached == 1) File.Copy(archive, Path.Combine(repoCache, sha + ".tar.gz"));
+#endif
+                    if (cached == 2)
+                    {
+                        string unpacked = Path.Combine(repoCache, sha);
+                        string fixture = archive.Substring(0, archive.Length - ".archive".Length);
+                        foreach (string file in Directory.GetFiles(fixture, "*", SearchOption.AllDirectories))
+                        {
+                            string destination = Path.Combine(unpacked, Path.GetRelativePath(fixture, file));
+                            Directory.CreateDirectory(Path.GetDirectoryName(destination));
+                            File.Copy(file, destination);
+                        }
+                    }
+                }
+                int targetDownloads = 0;
+                var client = new Mock<HttpClientHandler>();
+                client.Protected().Setup<Task<HttpResponseMessage>>("SendAsync", ItExpr.IsAny<HttpRequestMessage>(), ItExpr.IsAny<CancellationToken>())
+                    .Returns((HttpRequestMessage request, CancellationToken token) => {
+                        bool wrapper = request.RequestUri.AbsolutePath.Contains("/test/wrapper/");
+                        if (!wrapper) targetDownloads++;
+                        return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK) { Content = new ByteArrayContent(File.ReadAllBytes(wrapper ? wrapperArchive : archive)) });
+                    });
+                var factory = new Mock<IHttpClientHandlerFactory>();
+                factory.Setup(x => x.CreateClientHandler(It.IsAny<RunnerWebProxy>())).Returns(client.Object);
+                _hc.SetSingleton(factory.Object);
+                var wrapperStep = new Pipelines.ActionStep { Id = Guid.NewGuid(), Reference = new Pipelines.RepositoryPathReference { RepositoryType = "GitHub", Name = "test/wrapper", Ref = "main" } };
+                await _actionManager.PrepareActionsAsync(_ec.Object, composite ? new[] { wrapperStep } : new[] { targetStep, new Pipelines.ActionStep { Id = Guid.NewGuid(), Reference = target } });
+                Assert.Equal(cached != 0 ? 0 : 1, targetDownloads);
+                Assert.NotEmpty(infos);
+                // Mutating resolver objects cannot change the retained downloaded identity.
+                foreach (var info in infos) { info.ResolvedSha = "changed"; info.ResolvedNameWithOwner = "changed/repo"; }
+                AssertRegionalCacheEnvironment(target, regional);
+                AssertRegionalCacheEnvironment(new Pipelines.RepositoryPathReference { RepositoryType = "self", Name = name, Ref = reference, Path = path }, false);
+                AssertRegionalCacheEnvironment(new Pipelines.RepositoryPathReference { RepositoryType = "GitHub", Name = name, Ref = "unresolved-ref", Path = path }, false);
+                // A later local-composite preparation resolves the ref again. Extracted
+                // downloads retain their watermark; upstream symlinks have no watermark
+                // and therefore re-download when the newly resolved SHA is not cached.
+                sha = sha == CacheSha ? NodeSha : CacheSha;
+                await _actionManager.PrepareActionsAsync(_ec.Object, new[] { targetStep }, Guid.NewGuid());
+                Assert.Equal(cached == 1 ? 0 : 1, targetDownloads);
+                bool replacedRegional = resolvedName == name && (
+                    (name == "actions/cache" && sha == CacheSha && (path == "" || path == "restore" || path == "save"))
+                    || (name == "actions/setup-node" && sha == NodeSha && path == ""));
+                AssertRegionalCacheEnvironment(target, cached == 2 ? replacedRegional : regional);
+                string actionDirectory = Path.Combine(_hc.GetDirectory(WellKnownDirectory.Actions), name, reference);
+                Assert.Equal("unchanged action bytes", File.ReadAllText(Path.Combine(actionDirectory, "task.js")));
+            }
+            finally
+            {
+                Environment.SetEnvironmentVariable(Constants.Variables.Agent.ActionArchiveCacheDirectory, priorCache);
+                Environment.SetEnvironmentVariable(Constants.Variables.Agent.SymlinkCachedActions, priorSymlink);
+                Teardown();
+            }
+        }
+
+        private void AssertRegionalCacheEnvironment(Pipelines.RepositoryPathReference action, bool regional)
+        {
+            var environment = new Dictionary<string, string> {
+                ["ACTIONS_CACHE_URL"] = "https://github-cache.example/", ["ACTIONS_CACHE_SERVICE_V2"] = "True",
+                ["ACTIONS_RESULTS_URL"] = "https://results.example/", ["ACTIONS_RUNTIME_URL"] = "https://runtime.example/",
+                ["ACTIONS_RUNTIME_TOKEN"] = "runtime-token", ["ACTIONS_ID_TOKEN_REQUEST_URL"] = "https://oidc.example/",
+                ["ACTIONS_ID_TOKEN_REQUEST_TOKEN"] = "oidc-token", ["ACTIONS_CACHE_MODE"] = "mode"
+            };
+            var expected = new Dictionary<string, string>(environment);
+            if (regional) { expected["ACTIONS_CACHE_URL"] = RegionalCacheRoute.ApprovedRoute; expected.Remove("ACTIONS_CACHE_SERVICE_V2"); }
+            _ec.Object.Global.ApplyRegionalCacheRoute(action, environment);
+            Assert.Equal(expected.Count, environment.Count);
+            foreach (var pair in expected) Assert.Equal(pair.Value, environment[pair.Key]);
+        }
+
+        private string CreateRegionalCacheArchive(string yaml)
+        {
+            string directory = Path.Combine(_workFolder, "fixture-" + Guid.NewGuid().ToString("N"));
+            string repo = Path.Combine(directory, "repo");
+            Directory.CreateDirectory(repo);
+            foreach (string path in new[] { "", "restore", "save", "unsupported" })
+            {
+                string action = Path.Combine(repo, path);
+                Directory.CreateDirectory(action);
+                File.WriteAllText(Path.Combine(action, "action.yml"), yaml);
+                File.WriteAllText(Path.Combine(action, "task.js"), "unchanged action bytes");
+            }
+            string archive = directory + ".archive";
+#if OS_WINDOWS
+            ZipFile.CreateFromDirectory(directory, archive);
+#else
+            using var output = File.Create(archive);
+            using var gzip = new GZipStream(output, CompressionMode.Compress);
+            TarFile.CreateFromDirectory(directory, gzip, includeBaseDirectory: false);
+#endif
+            return archive;
+        }
+    }
+}
