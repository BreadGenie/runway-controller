+using GitHub.Runner.Worker;
+using Xunit;
+
+namespace GitHub.Runner.Common.Tests.Worker
+{
+    public sealed class RegionalCacheSetupL0 : IDisposable
+    {
+        private readonly string _directory = Path.Combine(Path.GetTempPath(), "runner-cache-" + Guid.NewGuid().ToString("N"));
+        public RegionalCacheSetupL0() { Directory.CreateDirectory(_directory); }
+        private static RegionalCacheSnapshot Snapshot(long requestId = 17)
+        {
+            // The pipeline wire contract uses Newtonsoft, not System.Text.Json setters.
+            var message = Newtonsoft.Json.JsonConvert.DeserializeObject<AgentJobRequestMessage>("{\"jobId\":\"328d267e-5e8a-42c9-8f85-b63842874f58\",\"requestId\":17,\"contextData\":{}}");
+            message = Newtonsoft.Json.JsonConvert.DeserializeObject<AgentJobRequestMessage>(Newtonsoft.Json.JsonConvert.SerializeObject(message).Replace("\"RequestId\":17", "\"RequestId\":" + requestId.ToString(System.Globalization.CultureInfo.InvariantCulture)));
+            return RegionalCacheSnapshot.Capture(message);
+        }
+        private string Helper(string body)
+        {
+            var path = Path.Combine(_directory, "helper.py");
+            File.WriteAllText(path, "import json,sys,os,time\nr=json.load(sys.stdin)\nr.pop('context')\n" + body + "\n");
+            return path;
+        }
+        private const string Enable = "r.update(outcome='enabled',route='http://127.0.0.1:18080/')\nprint(json.dumps(r))";
+        [Theory]
+        [InlineData(0L)]
+        [InlineData(17L)]
+        [InlineData(long.MaxValue)]
+        public async Task EnablesOnlyBoundEchoAndClearedEnvironment(long requestId)
+        {
+            var snapshot = Snapshot(requestId);
+            Assert.Equal(requestId, snapshot.RequestId);
+            var route = await RegionalCacheSetup.SelectAsync(snapshot, Helper("assert set(os.environ)<= {'LC_CTYPE'}\nassert r['request_id']>=0\n" + Enable), _directory, TimeSpan.FromSeconds(2), CancellationToken.None);
+            Assert.Same(RegionalCacheRoute.Enabled, route);
+        }
+        [Theory]
+        [InlineData("print('bad json')")]
+        [InlineData("print('{}')")]
+        [InlineData("sys.exit(1)")]
+        [InlineData("print('x'*4097)")]
+        [InlineData("sys.stderr.write('x'*4097)")]
+        [InlineData("r['nonce']='wrong'\n" + Enable)]
+        [InlineData("r['job_id']='wrong'\n" + Enable)]
+        [InlineData("r['request_id']=18\n" + Enable)]
+        [InlineData("r['extra']='secret'\n" + Enable)]
+        [InlineData("r.update(outcome='enabled',route='https://evil.example/')\nprint(json.dumps(r))")]
+        [InlineData("r.update(outcome='disabled',route=None)\nprint(json.dumps(r))")]
+        [InlineData("r.update(outcome='enabled',route='http://127.0.0.1:18080/')\nprint(json.dumps(r)[:-1]+',\"version\":1}')")]
+        public async Task FailureDisables(string body)
+        {
+            Assert.Same(RegionalCacheRoute.Disabled, await RegionalCacheSetup.SelectAsync(Snapshot(), Helper(body), _directory, TimeSpan.FromSeconds(2), CancellationToken.None));
+        }
+        [Fact]
+        public async Task TimeoutKillsHelperAndRejectsLateEnabledResponse()
+        {
+            var marker = Path.Combine(_directory, "late");
+            var helper = Helper("time.sleep(1)\nopen(" + JsonSerializer.Serialize(marker) + ",'w').close()\n" + Enable);
+            Assert.Same(RegionalCacheRoute.Disabled, await RegionalCacheSetup.SelectAsync(Snapshot(), helper, _directory, TimeSpan.FromMilliseconds(100), CancellationToken.None));
+            await Task.Delay(1100);
+            Assert.False(File.Exists(marker));
+        }
+        [Fact]
+        public async Task MissingHelperDisablesAndCancellationPropagates()
+        {
+            Assert.Same(RegionalCacheRoute.Disabled, await RegionalCacheSetup.SelectAsync(Snapshot(), Path.Combine(_directory,"missing"), _directory, TimeSpan.FromSeconds(2), CancellationToken.None));
+            using var cancellation = new CancellationTokenSource();
+            cancellation.CancelAfter(100);
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => RegionalCacheSetup.SelectAsync(Snapshot(), Helper("time.sleep(5)"), _directory, TimeSpan.FromSeconds(2), cancellation.Token));
+        }
+        [Fact]
+        public void RouteCannotBeReselected()
+        {
+            var global = new GlobalContext();
+            global.SetRegionalCacheRoute(RegionalCacheRoute.Enabled);
+            Assert.Throws<InvalidOperationException>(() => global.SetRegionalCacheRoute(RegionalCacheRoute.Disabled));
+        }
+        [Fact]
+        public void SnapshotIsAllowlistedScalarAndImmutable()
+        {
+            var message = Newtonsoft.Json.JsonConvert.DeserializeObject<AgentJobRequestMessage>("{\"jobId\":\"328d267e-5e8a-42c9-8f85-b63842874f58\",\"requestId\":17,\"contextData\":{}}");
+            var github = new DictionaryContextData();
+            github["repository"] = new StringContextData("owner/repo");
+            github["repository_id"] = new NumberContextData(123);
+            github["ref"] = new StringContextData("refs/heads/main");
+            github["event_name"] = new DictionaryContextData();
+            github["token"] = new StringContextData("never-serialize");
+            message.ContextData["github"] = github;
+            var snapshot = RegionalCacheSnapshot.Capture(message);
+            github["ref"] = new StringContextData("untrusted-later");
+            using var doc = JsonDocument.Parse(snapshot.Request);
+            var context = doc.RootElement.GetProperty("context");
+            Assert.Equal(10, context.EnumerateObject().Count());
+            Assert.Equal("123", context.GetProperty("repository_id").GetString());
+            Assert.Equal("refs/heads/main", context.GetProperty("ref").GetString());
+            Assert.Equal(JsonValueKind.Null, context.GetProperty("event_name").ValueKind);
+            Assert.DoesNotContain("never-serialize", snapshot.Request);
+            Assert.DoesNotContain("untrusted-later", snapshot.Request);
+        }
+        public void Dispose() { Directory.Delete(_directory, true); }
+    }
+}
