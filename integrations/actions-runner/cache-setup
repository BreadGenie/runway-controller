#!/usr/bin/python3 -I
"""Credential-free, bounded post-gate cache setup from frozen pre-gate context."""
import json
import signal
import socket
import sys
import uuid

ROUTE = "http://127.0.0.1:18080/"
IDENTITY = {"version", "job_id", "request_id", "nonce"}
CONTEXT = set("repository repository_id run_id run_attempt ref ref_type sha event_name base_ref head_ref".split())


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate field")
        result[key] = value
    return result


def read_object(stream, maximum):
    data = stream.read(maximum + 1)
    if not data or len(data) > maximum:
        raise ValueError("length")
    result = json.loads(data, object_pairs_hook=unique_object)
    if not isinstance(result, dict):
        raise ValueError("object")
    return result


def canonical_uuid(value):
    return isinstance(value, str) and str(uuid.UUID(value)) == value and uuid.UUID(value).int != 0


def validate_request(request):
    if (set(request) != IDENTITY | {"context"}
        or type(request["version"]) is not int or request["version"] != 1
        or not canonical_uuid(request["job_id"]) or not canonical_uuid(request["nonce"])
        or type(request["request_id"]) is not int or not 0 <= request["request_id"] < 2**63
        or not isinstance(request["context"], dict) or set(request["context"]) != CONTEXT
        or any(value is not None and (not isinstance(value, str) or len(value) > 2048)
               for value in request["context"].values())):
        raise ValueError("request")


def disabled(request):
    return {**{key: request[key] for key in IDENTITY}, "outcome": "disabled", "route": None}


def exchange(connection, request):
    validate_request(request)
    connection.settimeout(3)
    payload = json.dumps(request, separators=(",", ":")).encode("utf-8") + b"\n"
    if len(payload) > 32768:
        raise ValueError("request framing limit")
    connection.sendall(payload)
    # Firecracker does not forward guest write-half-close as EOF. Each host hop
    # is exactly one bounded JSON line; do not wait for either peer to close.
    data = bytearray()
    while b"\n" not in data and len(data) <= 4096:
        chunk = connection.recv(4097 - len(data))
        if not chunk:
            raise ValueError("unterminated response")
        data.extend(chunk)
    if len(data) > 4096 or not data.endswith(b"\n") or data.count(b"\n") != 1:
        raise ValueError("response framing")
    response = json.loads(data, object_pairs_hook=unique_object)
    if not isinstance(response, dict):
        raise ValueError("response object")
    if (set(response) != IDENTITY | {"outcome", "route"}
        or any(type(response[key]) is not type(request[key]) or response[key] != request[key] for key in IDENTITY)
        or not ((response["outcome"] == "enabled" and response["route"] == ROUTE)
                or (response["outcome"] == "disabled" and response["route"] is None))):
        raise ValueError("response")
    return response


def expired(signum, frame):
    raise TimeoutError("cache setup deadline")


def main():
    signal.signal(signal.SIGALRM, expired)
    signal.alarm(4)
    request = None
    try:
        request = read_object(sys.stdin.buffer, 32768)
        validate_request(request)
        response = disabled(request)
        try:
            # Availability only: no credentials or request bytes cross this probe.
            # Authority still belongs to the host's exact peer/assignment checks.
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.2)
                probe.connect(("127.0.0.1", 18080))
            # Dedicated new interface; never call or modify release port 1025.
            with socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM) as connection:
                connection.settimeout(1)
                connection.connect((socket.VMADDR_CID_HOST, 1026))
                response = exchange(connection, request)
        except (OSError, ValueError, TypeError, RecursionError):
            pass
        sys.stdout.write(json.dumps(response, separators=(",", ":")) + "\n")
        return 0
    except (OSError, ValueError, TypeError, RecursionError):
        return 1
    finally:
        signal.alarm(0)


if __name__ == "__main__":
    sys.exit(main())
