#!/usr/bin/python3 -I
"""Carry the loopback cache endpoint to pinned mesh TLS or standalone vsock."""

import json
import os
import re
import ssl
import stat
from pathlib import Path
import selectors
import signal
import socket
import threading
import time

ADDRESS = ("127.0.0.1", 18080)
HOST = (socket.VMADDR_CID_HOST, 1027)
BUFFER_BYTES = 65536
# A large save's finalize hashes and stores the archive before any byte comes
# back; idle must outlast the host's per-request limit (cache_host.go).
IDLE_SECONDS = 330
FIRST_BYTE_SECONDS = 5
CONNECTIONS = 8


def relay(left, right, stop, idle_seconds=IDLE_SECONDS):
    """Bound memory and idle lifetime while preserving byte order and half-close."""
    peers = {left: right, right: left}
    pending = {left: bytearray(), right: bytearray()}
    eof = set()
    shutdown = set()
    for connection in peers:
        connection.setblocking(False)
    deadline = time.monotonic() + idle_seconds
    with selectors.DefaultSelector() as selector:
        while not stop.is_set():
            if time.monotonic() >= deadline:
                return
            for connection, other in peers.items():
                if other in eof and not pending[connection] and connection not in shutdown:
                    # TLS cannot send a TCP FIN before reading the response: it
                    # would truncate the encrypted stream. HTTP frames requests.
                    if not isinstance(connection, ssl.SSLSocket):
                        connection.shutdown(socket.SHUT_WR)
                    shutdown.add(connection)
                events = 0
                if connection not in eof and len(pending[other]) < BUFFER_BYTES:
                    events |= selectors.EVENT_READ
                if pending[connection]:
                    events |= selectors.EVENT_WRITE
                try:
                    selector.unregister(connection)
                except KeyError:
                    pass
                if events:
                    selector.register(connection, events)
            if len(eof) == 2 and not any(pending.values()):
                return
            ready = [(key.fileobj, events) for key, events in
                     selector.select(min(0.1, max(0, deadline-time.monotonic())))]
            # OpenSSL can retain decrypted bytes after the fd stops being readable.
            for connection, other in peers.items():
                if (isinstance(connection, ssl.SSLSocket) and connection.pending()
                        and connection not in eof and len(pending[other]) < BUFFER_BYTES
                        and not any(peer is connection for peer, _ in ready)):
                    ready.append((connection, selectors.EVENT_READ))
            for connection, events in ready:
                other = peers[connection]
                if events & selectors.EVENT_READ:
                    try:
                        data = connection.recv(BUFFER_BYTES-len(pending[other]))
                    except (BlockingIOError, ssl.SSLWantReadError, ssl.SSLWantWriteError):
                        continue
                    if data:
                        pending[other].extend(data)
                        deadline = time.monotonic() + idle_seconds
                    else:
                        eof.add(connection)
                if events & selectors.EVENT_WRITE:
                    try:
                        sent = connection.send(pending[connection])
                    except (BlockingIOError, ssl.SSLWantReadError, ssl.SSLWantWriteError):
                        continue
                    if sent == 0:
                        return
                    del pending[connection][:sent]
                    deadline = time.monotonic() + idle_seconds


def record_error():
    try:
        fd = os.open("/run/runway/metric-relay_errors",
                     os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        with os.fdopen(fd, "wb") as stream:
            entry = os.fstat(stream.fileno())
            if stat.S_ISREG(entry.st_mode) and entry.st_size < 1 << 20:
                stream.write(b"1")
    except OSError:
        pass


def serve(listener, stop, connect, first_byte_seconds=FIRST_BYTE_SECONDS):
    """Own every connection and worker; the host enforces attempt authorization."""
    slots = threading.BoundedSemaphore(CONNECTIONS)
    workers = set()
    listener.settimeout(0.1)

    def worker(connection):
        try:
            with connection:
                # The setup availability probe sends no HTTP. Do not occupy a
                # native socket whose guest half-close Firecracker cannot relay.
                connection.settimeout(0.1)
                deadline = time.monotonic() + first_byte_seconds
                while not stop.is_set() and time.monotonic() < deadline:
                    try:
                        first = connection.recv(1, socket.MSG_PEEK)
                        break
                    except socket.timeout:
                        continue
                else:
                    return
                if not first:
                    return
                with connect() as upstream:
                    relay(connection, upstream, stop)
        except OSError:
            record_error()  # Close this byte stream without logging data or retrying writes.
        finally:
            slots.release()

    try:
        while not stop.is_set():
            finished = {thread for thread in workers if not thread.is_alive()}
            for thread in finished:
                thread.join()
            workers.difference_update(finished)
            try:
                connection, _ = listener.accept()
            except socket.timeout:
                continue
            if not slots.acquire(blocking=False):
                connection.close()
                record_error()
                continue
            thread = threading.Thread(target=worker, args=(connection,))
            try:
                thread.start()
            except RuntimeError:
                connection.close()
                slots.release()
                raise
            workers.add(thread)
    finally:
        stop.set()
        listener.close()
        for thread in workers:
            thread.join()


def connect_host():
    connection = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    try:
        connection.settimeout(5)
        connection.connect(HOST)
        return connection
    except OSError:
        connection.close()
        raise


CONFIG = Path("/etc/runway/cache.json")


def trusted_read(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        entry = os.fstat(stream.fileno())
        if (not stat.S_ISREG(entry.st_mode) or entry.st_uid != 0
                or entry.st_mode & 0o022 or entry.st_size > 1048576):
            raise ValueError("unsafe cache configuration")
        return stream.read(1048577)


def connector(path=CONFIG):
    try:
        raw = trusted_read(path)
    except FileNotFoundError:
        return connect_host
    config = json.loads(raw)
    if config == {"version": 1, "mode": "vsock"}:
        return connect_host
    if (set(config) != {"version", "mode", "service", "ca_file"}
            or config["version"] != 1 or config["mode"] != "service"
            or not re.fullmatch(r"(?:internal-[a-z0-9][a-z0-9.-]*|\[fdaa:[a-f0-9:]+\]):[0-9]+", config["service"])
            or config["ca_file"] != "/etc/runway/cache-ca.pem"):
        raise ValueError("invalid cache configuration")
    host, port = config["service"].rsplit(":", 1)
    if not 1 <= int(port) <= 65535:
        raise ValueError("invalid cache port")
    return tls_connector(host.strip("[]"), int(port), trusted_read(config["ca_file"]))


def tls_connector(host, port, ca):
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_verify_locations(cadata=ca.decode("ascii"))

    def connect():
        connection = socket.create_connection((host, port), timeout=5)
        try:
            return context.wrap_socket(connection, server_hostname=host)
        except BaseException:
            connection.close()
            raise
    return connect


def main():
    connect = connector()
    stop = threading.Event()
    for number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(number, lambda *_: stop.set())
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
        listener.bind(ADDRESS)
        listener.listen(CONNECTIONS)
        serve(listener, stop, connect)


if __name__ == "__main__":
    main()
