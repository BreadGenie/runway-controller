[Unit]
Description=Runway regional cache Garage (single node, loopback only)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=runway-garage
Group=runway-garage
ExecStart=/opt/runway-garage/bin/garage -c /etc/runway-garage/garage.toml server
Restart=always
RestartSec=5
UMask=0077
LimitNOFILE=65536
MemoryMax=4G
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/runway-garage
ReadOnlyPaths=/etc/runway-garage
InaccessiblePaths=-/etc/runway-cache
Environment=RUST_LOG=garage=info

[Install]
WantedBy=multi-user.target
